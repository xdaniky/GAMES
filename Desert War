CrossV.Visible = false

-- Sistem Manajemen Drawing Text ESP per Player
local drawingCache = {}

local function removeDrawingESP(player)
    if drawingCache[player] then
        drawingCache[player]:Remove()
        drawingCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeDrawingESP)

-- Loop Utama RenderStepped (Update Visual, Crosshair, & Aimbot)
RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    
    -- Update FOV Circle
    FOVCircle.Position = mousePos
    FOVCircle.Radius = Config.FOVSize
    FOVCircle.Visible = Config.Aimbot and Config.FOV

    -- Update Custom Crosshair (di tengah layar)
    if Config.Crosshair then
        local vpSize = Camera.ViewportSize
        local center = Vector2.new(vpSize.X / 2, vpSize.Y / 2)
        local size = Config.CrosshairSize

        CrossH.From = Vector2.new(center.X - size, center.Y)
        CrossH.To = Vector2.new(center.X + size, center.Y)
        CrossH.Color = Config.CrosshairColor
        CrossH.Visible = true

        CrossV.From = Vector2.new(center.X, center.Y - size)
        CrossV.To = Vector2.new(center.X, center.Y + size)
        CrossV.Color = Config.CrosshairColor
        CrossV.Visible = true
    else
        CrossH.Visible = false
        CrossV.Visible = false
    end

    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart") then
                -- 1. Chams Logic
                local hl = char:FindFirstChild("DW_Highlight")
                if Config.Chams then
                    if not hl then
                        hl = Instance.new("Highlight")
                        hl.Name = "DW_Highlight"
                        hl.Adornee = char
                        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                        hl.Parent = char
                    end
                    if isRealEnemy(player) then
                        hl.FillColor = Config.EnemyColor
                        hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    else
                        hl.FillColor = Config.TeamColor
                        hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                    end
                    hl.Enabled = true
                else
                    if hl then hl.Enabled = false end
                end

                -- 2. Drawing Text Name + Distance ESP
                local textObj = drawingCache[player]
                if Config.DrawingESP and isRealEnemy(player) then
                    if not textObj then
                        textObj = Drawing.new("Text")
                        textObj.Size = 16
                        textObj.Center = true
                        textObj.Outline = true
                        textObj.Color = Color3.fromRGB(255, 255, 255)
                        drawingCache[player] = textObj
                    end

                    local headPos, onScreen = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0, 0.8, 0))
                    if onScreen then
                        local dist = localHRP and math.floor((char.HumanoidRootPart.Position - localHRP.Position).Magnitude) or 0
                        textObj.Text = player.Name .. " [" .. dist .. "m]"
                        textObj.Position = Vector2.new(headPos.X, headPos.Y)
                        textObj.Visible = true
                    else
                        textObj.Visible = false
                    end
                else
                    if textObj then
                        textObj.Visible = false
                    end
                end
            else
                removeDrawingESP(player)
            end
        end
    end

    -- 3. Aimbot Toggle Logic dengan Target Selector & Wall Check
    if Config.Aimbot then
        local closestTarget = nil
        local shortestDist = Config.FOVSize

        for _, player in ipairs(Players:GetPlayers()) do
            if isRealEnemy(player) and player.Character then
                local char = player.Character
                -- Jika toggle "Target ke Kepala" aktif ->incar Head, jika off -> incar HumanoidRootPart (Badan)
                local targetPart = Config.AimHead and char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                
                if targetPart then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and isVisible(targetPart, char) then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                            if screenDist < shortestDist then
                                shortestDist = screenDist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTarget.Position), 0.3)
        end
    end
end)

