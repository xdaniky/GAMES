-- Fungsi Pembuat Tab
local tabs = {}
local function CreateTab(tabName)
    local TabFrame = Instance.new("ScrollingFrame")
    TabFrame.Parent = ContentContainer
    TabFrame.BackgroundTransparency = 1
    TabFrame.Size = UDim2.new(1, 0, 1, 0)
    TabFrame.CanvasSize = UDim2.new(0, 0, 0, 300)
    TabFrame.ScrollBarThickness = 3
    TabFrame.Visible = false
    
    local TabList = Instance.new("UIListLayout")
    TabList.Parent = TabFrame
    TabList.SortOrder = Enum.SortOrder.LayoutOrder
    TabList.Padding = UDim.new(0, 10)
    
    local TabBtn = Instance.new("TextButton")
    TabBtn.Parent = Sidebar
    TabBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
    TabBtn.Size = UDim2.new(1, 0, 0, 38)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    TabBtn.TextSize = 13
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    
    TabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Frame.Visible = false
            t.Button.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
            t.Button.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        TabFrame.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)
    
    table.insert(tabs, {Frame = TabFrame, Button = TabBtn})
    if #tabs == 1 then
        TabFrame.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 65)
        TabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end
    
    return TabFrame
end

