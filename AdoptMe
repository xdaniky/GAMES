-- 1. Anti-AFK Bypasser agar akun tidak ter-kick otomatis
task.spawn(function()
    pcall(function()
        local vu = game:GetService("VirtualUser")
        game:GetService("Players").LocalPlayer.Idled:Connect(function()
            vu:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
            task.wait(1)
            vu:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        end)
    end)
end)

-- 2. Inisialisasi Modul Internal Game untuk Jalur Farm
task.spawn(function()
    pcall(function()
        local ReplicatedStorage = game:GetService("ReplicatedStorage")
        local ClientModules = ReplicatedStorage:FindFirstChild("ClientModules")
        if ClientModules then
            require(ClientModules.Core.InteriorsM)
        end
    end)
end)

-- 3. Loop Utama Pemantau Status & Farm Handler
task.spawn(function()
    while true do
        pcall(function()
            -- Memastikan konfigurasi dasar tetap aktif
            if not getgenv().VO_CONFIG then
                getgenv().VO_CONFIG = { PetFarm = true }
            end
        end)
        task.wait(2)
    end
end)

print("[SUCCESS] Script Auto Farm berhasil dimuat dan berjalan di latar belakang!")
