-- 1. Auto Click / Farm Function (Tap Service)
local function SendTap()
    pcall(function()
        local remoteFolder = ReplicatedStorage:WaitForChild("RemoteServices", 5)
        local tapService = remoteFolder and remoteFolder:WaitForChild("TapService", 5)
        local reFolder = tapService and tapService:WaitForChild("RE", 5)
        local tapEvent = reFolder and reFolder:WaitForChild("TapRequested", 5)
        
        if tapEvent then
            clientSequenceCounter = clientSequenceCounter + 1
            tapEvent:FireServer({
                ClientSequence = clientSequenceCounter,
                Auto = false,
                Source = "screen"
            })
        end
    end)
end

task.spawn(function()
    while true do
        if getgenv().AutoClicking then
            SendTap()
            task.wait(ClickDelay)
        else
            task.wait(0.1)
        end
    end
end)

-- 2. Fungsi Scan Telur & Harga (Dengan Cache Memory)
local function ScanEggs()
    local eggsFolder = Workspace:FindFirstChild("Eggs")
    if eggsFolder then
        local success, children = pcall(function() return eggsFolder:GetChildren() end)
        if success and children then
            for _, item in ipairs(children) do
                if item:IsA("Folder") or item:IsA("Model") then
                    local name = item.Name
                    if name ~= "30M Visits" then
                        local priceText = ""
                        for _, desc in ipairs(item:GetDescendants()) do
                            if desc:IsA("TextLabel") and (desc.Text:match("%d") or desc.Text:match("K") or desc.Text:match("M") or desc.Text:match("B") or desc.Text:match("QD")) then
                                if not desc.Text:match("%%") and #desc.Text < 15 then
                                    priceText = desc.Text
                                    break
                                end
                            end
                        end
                        
                        if priceText ~= "" then
                            cachedEggPrices[name] = priceText
                        end
                    end
                end
            end
        end
    end

    table.clear(eggNames)
    table.clear(eggObjects)
    
    if eggsFolder then
        local success, children = pcall(function() return eggsFolder:GetChildren() end)
        if success and children then
            for _, item in ipairs(children) do
                if item:IsA("Folder") or item:IsA("Model") then
                    local name = item.Name
                    if name ~= "30M Visits" then
                        local priceText = ""
                        for _, desc in ipairs(item:GetDescendants()) do
                            if desc:IsA("TextLabel") and (desc.Text:match("%d") or desc.Text:match("K") or desc.Text:match("M") or desc.Text:match("B") or desc.Text:match("QD")) then
                                if not desc.Text:match("%%") and #desc.Text < 15 then
                                    priceText = desc.Text
                                    break
                                end
                            end
                        end
                        
                        if priceText == "" and cachedEggPrices[name] then
                            priceText = cachedEggPrices[name]
                        end
                        
                        local displayName = priceText ~= "" and (name .. " (Harga: " .. priceText .. ")") or name
                        table.insert(eggNames, displayName)
                        eggObjects[displayName] = item
                    end
                end
            end
        end
    end
    
    table.sort(eggNames)
    if #eggNames == 0 then table.insert(eggNames, "None Found") end
    getgenv().SelectedEgg = eggNames[1]
end

ScanEggs()

-- 3. Sistem Auto Hatch Telur
local lastTeleportedEgg = nil
task.spawn(function()
    while true do
        if getgenv().AutoFarmEgg and getgenv().SelectedEgg then
            pcall(function()
                local targetEggFolder = eggObjects[getgenv().SelectedEgg]
                if targetEggFolder then
                    if lastTeleportedEgg ~= getgenv().SelectedEgg then
                        local tpPart = targetEggFolder:FindFirstChild("2") 
                            or targetEggFolder:FindFirstChild("1") 
                            or targetEggFolder:FindFirstChild("PriceTag") 
                            or targetEggFolder:FindFirstChild("Egg")
                        
                        local character = LocalPlayer.Character
                        if tpPart and tpPart:IsA("BasePart") and character and character:FindFirstChild("HumanoidRootPart") then
                            character.HumanoidRootPart.CFrame = tpPart.CFrame + Vector3.new(0, 3, 0)
                            lastTeleportedEgg = getgenv().SelectedEgg
                            task.wait(0.5)
                        end
                    end

                    for _, desc in ipairs(targetEggFolder:GetDescendants()) do
                        if desc:IsA("ProximityPrompt") then
                            if fireproximityprompt then fireproximityprompt(desc) end
                        end
                    end

                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
                end
            end)
        else
            lastTeleportedEgg = nil
        end
        task.wait(0.2)
    end
end)

-- 4. Sistem Auto Farm Breakable (Simulasi Klik Fisik & Teleport 1 per 1)
task.spawn(function()
    while true do
        if getgenv().AutoBreakableActive then
            pcall(function()
                local targets = {}
                
                local breakablesFolder = Workspace:FindFirstChild("Breakables")
                if breakablesFolder then
                    for _, item in ipairs(breakablesFolder:GetChildren()) do
                        if item:IsA("Model") or item:IsA("Folder") then
                            table.insert(targets, item)
                        end
                    end
                end

                local clickerChest = Workspace:FindFirstChild("ClickerChest")
                if clickerChest then
                    table.insert(targets, clickerChest)
                end

                for _, item in ipairs(Workspace:GetChildren()) do
                    if item:IsA("Model") or item:IsA("Folder") then
                        local nameLower = string.lower(item.Name)
                        if nameLower:find("rock") or nameLower:find("cloud") or nameLower:find("ore") or nameLower:find("pumpkin") or nameLower:find("mushroom") or nameLower:find("cactus") or nameLower:find("crystal") or nameLower:find("void") or item:FindFirstChild("Hitbox") then
                            if not table.find(targets, item) then
                                table.insert(targets, item)
                            end
                        end
                    end
                end
                
                for _, item in ipairs(targets) do
                    if not getgenv().AutoBreakableActive then break end
                    
                    local startTime = tick()
                    while item and item.Parent and getgenv().AutoBreakableActive do
                        if tick() - startTime > 12 then break end

                        local character = LocalPlayer.Character
                        local primaryPart = item.PrimaryPart or item:FindFirstChild("Hitbox") or item:FindFirstChildWhichIsA("BasePart")
                        
                        if primaryPart and character and character:FindFirstChild("HumanoidRootPart") then
                            character.HumanoidRootPart.CFrame = primaryPart.CFrame + Vector3.new(0, 3, 0)
                        end

                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                        task.wait(0.05)
                        VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)

                        for _, desc in ipairs(item:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                pcall(function() fireproximityprompt(desc) end)
                            elseif desc:IsA("ClickDetector") then
                                pcall(function() fireclickdetector(desc) end)
                            end
                        end
                        
                        task.wait(0.1)
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

