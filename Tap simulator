-- 7. Fungsi & Sistem Auto Claim Quest (PlayerGui.RightHud.Main.RightUI.Quests + Remote ClaimQuest)
local function TriggerGuiButton(btn)
    if not btn then return end
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.MouseButton1Down) end)
        pcall(function() firesignal(btn.MouseButton1Up) end)
        pcall(function() firesignal(btn.Activated) end)
    end
    if getconnections then
        for _, sig in ipairs({btn.MouseButton1Click, btn.MouseButton1Down, btn.MouseButton1Up, btn.Activated}) do
            pcall(function()
                for _, conn in ipairs(getconnections(sig)) do
                    pcall(function() conn:Fire() end)
                end
            end)
        end
    end
end

local function ClaimAllQuests()
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        local rightHud = playerGui and playerGui:FindFirstChild("RightHud")
        local questsRoot = rightHud 
            and rightHud:FindFirstChild("Main") 
            and rightHud.Main:FindFirstChild("RightUI") 
            and rightHud.Main.RightUI:FindFirstChild("Quests")
        local questsList = questsRoot and questsRoot:FindFirstChild("List")
            
        local questService = ReplicatedStorage:FindFirstChild("RemoteServices") 
            and ReplicatedStorage.RemoteServices:FindFirstChild("QuestService")
        local reFolder = questService and questService:FindFirstChild("RE")
        local rfFolder = questService and questService:FindFirstChild("RF")
        
        local claimRE = reFolder and reFolder:FindFirstChild("ClaimQuest")
        local claimRF = rfFolder and rfFolder:FindFirstChild("ClaimQuest")

        local container = questsList or questsRoot
        if container then
            for _, questCard in ipairs(container:GetChildren()) do
                if questCard:IsA("GuiObject") and questCard.Visible then
                    local isReadyToClaim = false
                    local buttons = {}
                    
                    if questCard:IsA("GuiButton") then
                        table.insert(buttons, questCard)
                    end
                    
                    for _, desc in ipairs(questCard:GetDescendants()) do
                        if (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Visible then
                            local txt = string.lower(desc.Text or "")
                            if string.find(txt, "click to claim") or txt == "claim" or txt == "claim!" then
                                isReadyToClaim = true
                            end
                        end
                        if desc:IsA("GuiButton") then
                            table.insert(buttons, desc)
                        end
                    end

                    if isReadyToClaim then
                        local qId = questCard.Name
                        
                        if claimRE and claimRE:IsA("RemoteEvent") then
                            claimRE:FireServer(qId)
                            claimRE:FireServer({ Id = qId })
                            claimRE:FireServer({ QuestId = qId })
                            claimRE:FireServer({ Key = qId })
                        end

                        if claimRF and claimRF:IsA("RemoteFunction") then
                            task.spawn(function()
                                pcall(function() claimRF:InvokeServer(qId) end)
                                pcall(function() claimRF:InvokeServer({ Id = qId }) end)
                                pcall(function() claimRF:InvokeServer({ QuestId = qId }) end)
                            end)
                        end

                        for _, btn in ipairs(buttons) do
                            TriggerGuiButton(btn)
                        end
                    end
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        if getgenv().AutoClaimQuestActive then
            ClaimAllQuests()
        end
        task.wait(2)
    end
end)

