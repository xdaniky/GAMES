-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create Main Window
local Window = Rayfield:CreateWindow({
   Name = "Auto Clicker Debug",
   LoadingTitle = "Loading...",
   LoadingSubtitle = "Diagnostic Mode",
   ConfigurationSaving = { Enabled = false },
   KeySystem = false,
})

-- Create Main Tab
local MainTab = Window:CreateTab("Main", "mouse-pointer")

-- Auto Click Variables
getgenv().AutoClicking = false
local ClickDelay = 0.1
local clickCount = 0

-- Remote Tap Function with Debug Prints
local function SendTap()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    -- Safely locate the remote event
    local remoteFolder = ReplicatedStorage:FindFirstChild("RemoteServices")
    if remoteFolder then
        local tapService = remoteFolder:FindFirstChild("TapService")
        if tapService then
            local re = tapService:FindFirstChild("RE")
            if re then
                local event = re:FindFirstChild("TapRequested")
                if event then
                    clickCount = clickCount + 1
                    local success, err = pcall(function()
                        event:FireServer({
                            ClientSequence = clickCount, -- Dynamic sequence in case the game checks it
                            Auto = false,
                            Source = "screen"
                        })
                    end)
                    if not success then
                        warn("FireServer error: " + tostring(err))
                    else
                        print("Successfully fired tap #" .. clickCount)
                    end
                    return
                end
            end
        end
    end
    
    warn("Remote path not found! Check if the game updated its structure.")
end

-- Auto Click Toggle
MainTab:CreateToggle({
   Name = "Auto Click (Debug)",
   CurrentValue = false,
   Flag = "AutoClickToggle",
   Callback = function(Value)
      getgenv().AutoClicking = Value
      
      if getgenv().AutoClicking then
         task.spawn(function()
            while getgenv().AutoClicking do
               SendTap()
               task.wait(ClickDelay)
            end
         end)
         Rayfield:Notify({
            Title = "Status",
            Content = "Auto Click Started",
            Duration = 2,
         })
      else
         Rayfield:Notify({
            Title = "Status",
            Content = "Auto Click Stopped",
            Duration = 2,
         })
      end
   end,
})

-- Click Delay Slider
MainTab:CreateSlider({
   Name = "Click Delay (Seconds)",
   Range = {0.01, 1},
   Increment = 0.01,
   Suffix = "s",
   CurrentValue = 0.1,
   Flag = "ClickDelaySlider",
   Callback = function(Value)
      ClickDelay = Value
   end,
})

-- Loaded Notification
Rayfield:Notify({
   Title = "Loaded",
   Content = "Check F9 console if clicks don't register.",
   Duration = 3,
})
