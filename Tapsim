-- Load Rayfield UI Library
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Create Main Window
local Window = Rayfield:CreateWindow({
   Name = "xdaniky | Auto Clicker",
   LoadingTitle = "Loading Auto Tap...",
   LoadingSubtitle = "Optimized for TS2",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = nil,
      FileName = "AutoTapConfig"
   },
   KeySystem = false,
})

-- Create Main Tab
local MainTab = Window:CreateTab("Main", "mouse-pointer")

-- Auto Click Variables
getgenv().AutoClicking = false
local ClickDelay = 0.1
local clientSequenceCounter = 2

-- Remote Tap Function with Auto-Incrementing Sequence
local function SendTap()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    
    local success, err = pcall(function()
        local remoteFolder = ReplicatedStorage:WaitForChild("RemoteServices", 5)
        local tapService = remoteFolder and remoteFolder:WaitForChild("TapService", 5)
        local reFolder = tapService and tapService:WaitForChild("RE", 5)
        local tapEvent = reFolder and reFolder:WaitForChild("TapRequested", 5)
        
        if tapEvent then
            clientSequenceCounter = clientSequenceCounter + 1
            tapEvent:FireServer({
                ClientSequence = clientSequenceCounter,
                Auto = false,
                Source = "screen"
            })
        else
            warn("TapRequested RemoteEvent not found!")
        end
    end)
    
    if not success then
        warn("Failed to fire tap: " .. tostring(err))
    end
end

-- Auto Click Toggle
MainTab:CreateToggle({
   Name = "Auto Click",
   CurrentValue = false,
   Flag = "AutoClickToggle",
   Callback = function(Value)
      getgenv().AutoClicking = Value
      
      if getgenv().AutoClicking then
         task.spawn(function()
            while getgenv().AutoClicking do
               SendTap()
               task.wait(ClickDelay)
            end
         end)
         Rayfield:Notify({
            Title = "Auto Click",
            Content = "Auto Click Enabled",
            Duration = 2,
            Image = 4483362458,
         })
      else
         Rayfield:Notify({
            Title = "Auto Click",
            Content = "Auto Click Disabled",
            Duration = 2,
            Image = 4483362458,
         })
      end
   end,
})

-- Click Delay Slider
MainTab:CreateSlider({
   Name = "Click Delay (Seconds)",
   Range = {0.01, 1},
   Increment = 0.01,
   Suffix = "s",
   CurrentValue = 0.1,
   Flag = "ClickDelaySlider",
   Callback = function(Value)
      ClickDelay = Value
   end,
})

-- Loaded Notification
Rayfield:Notify({
   Title = "Script Loaded",
   Content = "ClientSequence counter integrated successfully.",
   Duration = 3,
   Image = 4483362458,
})
