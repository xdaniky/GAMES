-- Memuat Library Rayfield
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- Membuat Window Utama
local Window = Rayfield:CreateWindow({
   Name = "xdaniky | Auto Clicker",
   LoadingTitle = "Memuat Auto Tap...",
   LoadingSubtitle = "by xdaniky",
   ConfigurationSaving = {
      Enabled = false,
      FolderName = nil,
      FileName = "AutoTapConfig"
   },
   KeySystem = false, -- Ganti true jika ingin pakai key system
})

-- Membuat Tab Utama
local MainTab = Window:CreateTab("Utama", "mouse-pointer")

-- Variabel untuk mengontrol Auto Click
local _G.AutoClicking = false
local ClickDelay = 0.1 -- Jeda waktu antar klik (detik)

-- Fungsi untuk melakukan Tap ke RemoteService
local function SendTap()
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local success, err = pcall(function()
        local Event = ReplicatedStorage.RemoteServices.TapService.RE.TapRequested
        Event:FireServer({
            ClientSequence = 2,
            Auto = false,
            Source = "screen"
        })
    end)
    if not success then
        warn("Gagal mengirim tap: " .. tostring(err))
    end
end

-- Toggle untuk Auto Clicker
MainTab:CreateToggle({
   Name = "Auto Click",
   CurrentValue = false,
   Flag = "AutoClickToggle",
   Callback = function(Value)
      _G.AutoClicking = Value
      
      if _G.AutoClicking then
         task.spawn(function()
            while _G.AutoClicking do
               SendTap()
               task.wait(ClickDelay)
            end
         end)
         Rayfield:Notify({
            Title = "Auto Click",
            Content = "Auto Click diaktifkan!",
            Duration = 2,
            Image = 4483362458,
         })
      else
         Rayfield:Notify({
            Title = "Auto Click",
            Content = "Auto Click dimatikan!",
            Duration = 2,
            Image = 4483362458,
         })
      end
   end,
})

-- Slider untuk mengatur kecepatan klik (Delay)
MainTab:CreateSlider({
   Name = "Kecepatan Klik (Delay detik)",
   Range = {0.01, 1},
   Increment = 0.01,
   Suffix = "s",
   CurrentValue = 0.1,
   Flag = "ClickDelaySlider",
   Callback = function(Value)
      ClickDelay = Value
   end,
})

-- Notifikasi bahwa script berhasil dimuat
Rayfield:Notify({
   Title = "Script Berhasil Dimuat",
   Content = "UI Rayfield Minimalis siap digunakan.",
   Duration = 3,
   Image = 4483362458,
})
