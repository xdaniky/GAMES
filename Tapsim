-- Target Egg Paths based on your details
local function getEggModel()
    local eggsFolder = Workspace:FindFirstChild("Eggs")
    if eggsFolder then
        local heavenFolder = eggsFolder:FindFirstChild("Heaven")
        if heavenFolder then
            return heavenFolder:FindFirstChild("Egg")
        end
    end
    return nil
end

local function getEggTeleportPart()
    local eggsFolder = Workspace:FindFirstChild("Eggs")
    if eggsFolder then
        local heavenFolder = eggsFolder:FindFirstChild("Heaven")
        if heavenFolder then
            return heavenFolder:FindFirstChild("2")
        end
    end
    return nil
end

