        task.wait(5)
    end
end)

-- 7. Fungsi & Sistem Auto Claim Quest (QuestService.RF)
local function ClaimAllQuests()
    pcall(function()
        local questService = ReplicatedStorage:FindFirstChild("RemoteServices") 
            and ReplicatedStorage.RemoteServices:FindFirstChild("QuestService")
        local rfFolder = questService and questService:FindFirstChild("RF")
        
        if rfFolder then
            for _, rf in ipairs(rfFolder:GetChildren()) do
                if rf:IsA("RemoteFunction") then
                    -- Jalankan di thread terpisah agar InvokeServer tidak menahan loop jika server lambat merespons
                    task.spawn(function()
                        pcall(function() rf:InvokeServer() end)
                        for i = 1, 10 do
                            pcall(function() rf:InvokeServer(i) end)
                            pcall(function() rf:InvokeServer({ Index = i }) end)
                            pcall(function() rf:InvokeServer({ QuestId = i }) end)
                        end
                    end)
                end
            end
        end
    end)
end

task.spawn(function()
    while true do
        if getgenv().AutoClaimQuestActive then
            ClaimAllQuests()
        end
        task.wait(5) -- Pengecekan klaim quest setiap 5 detik
    end
end)

-- 8. Sistem Auto Rebirth
task.spawn(function()
    while true do
        if getgenv().AutoRebirthActive then
            pcall(function()
                local reFolder = ReplicatedStorage:FindFirstChild("RemoteServices") 
                    and ReplicatedStorage.RemoteServices:FindFirstChild("RebirthService") 
                    and ReplicatedStorage.RemoteServices.RebirthService:FindFirstChild("RE")
                
                if reFolder then
                    local rebirthReq = reFolder:FindFirstChild("RebirthRequested")
                    if rebirthReq then
                        rebirthReq:FireServer({ Index = selectedRebirthIndex })
                    end
                    
                    local autoSlot = reFolder:FindFirstChild("AutoSlotChanged")
                    if autoSlot then
                        autoSlot:FireServer(selectedRebirthIndex, true)
                    end
                end
            end)
        end
        task.wait(0.5)
    end
end)

