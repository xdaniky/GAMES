end)

-- 6. Fungsi & Sistem Auto Equip Best Pets (PetService)
local function EquipBestPets()
    pcall(function()
        local petService = ReplicatedStorage:FindFirstChild("RemoteServices") 
            and ReplicatedStorage.RemoteServices:FindFirstChild("PetService")
        local reFolder = petService and petService:FindFirstChild("RE")
        
        if reFolder then
            local petAction = reFolder:FindFirstChild("PetActionRequested")
            if petAction then
                petAction:FireServer("EquipBest")
                petAction:FireServer({ Action = "EquipBest" })
                petAction:FireServer("Equip Best")
            end
        end
    end)
end

task.spawn(function()
