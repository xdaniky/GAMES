-- Cache untuk Screen ESP Label per Player (Dijamin muncul di Delta)
local screenEspCache = {}

local function removeScreenESP(player)
    if screenEspCache[player] then
        screenEspCache[player]:Destroy()
        screenEspCache[player] = nil
    end
end

Players.PlayerRemoving:Connect(removeScreenESP)

local function setupChams(player, char)
    if player == LocalPlayer then return end
    local hl = char:FindFirstChild("DW_Highlight")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "DW_Highlight"
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
    end
end

local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        setupChams(player, char)
    end)
    if player.Character then
        task.spawn(function()
            setupChams(player, player.Character)
        end)
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, p in ipairs(Players:GetPlayers()) do
    onPlayerAdded(p)
end

RunService.RenderStepped:Connect(function()
    -- Titik Pusat Layar Mutlak (Center Screen)
    local vpSize = Camera.ViewportSize
    local centerScreen = Vector2.new(vpSize.X / 2, vpSize.Y / 2)
    
    if Config.Aimbot and Config.FOV then
        FOVFrame.Visible = true
        FOVFrame.Position = UDim2.new(0, centerScreen.X, 0, centerScreen.Y)
        local size = Config.FOVSize * 2
        FOVFrame.Size = UDim2.new(0, size, 0, size)
    else
        FOVFrame.Visible = false
    end

    if Config.Crosshair then
        local cx, cy = centerScreen.X, centerScreen.Y
        local s = Config.CrosshairSize

        CrossH.Visible = true
        CrossH.Position = UDim2.new(0, cx, 0, cy)
        CrossH.Size = UDim2.new(0, s * 2, 0, 2)
        CrossH.BackgroundColor3 = Config.CrosshairColor

        CrossV.Visible = true
        CrossV.Position = UDim2.new(0, cx, 0, cy)
        CrossV.Size = UDim2.new(0, 2, 0, s * 2)
        CrossV.BackgroundColor3 = Config.CrosshairColor
    else
        CrossH.Visible = false
        CrossV.Visible = false
    end

    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

    -- Update Chams & 2D Screen ESP (Nama + Distance)
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("Head") and char:FindFirstChild("HumanoidRootPart") then
                -- Chams
                local hl = char:FindFirstChild("DW_Highlight")
                if hl then
                    if Config.Chams then
                        if isRealEnemy(player) then
                            hl.FillColor = Config.EnemyColor
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        else
                            hl.FillColor = Config.TeamColor
                            hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                        end
                        hl.Enabled = true
                    else
                        hl.Enabled = false
                    end
                end

                -- Screen ESP 2D (Teks Nama + Jarak di atas kepala musuh via ScreenGui)
                local textLabel = screenEspCache[player]
                if Config.ScreenESP and isRealEnemy(player) then
                    if not textLabel then
                        textLabel = Instance.new("TextLabel")
                        textLabel.BackgroundTransparency = 1
                        textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                        textLabel.TextSize = 13
                        textLabel.Font = Enum.Font.SourceSansBold
                        textLabel.TextStrokeTransparency = 0
                        textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                        textLabel.AnchorPoint = Vector2.new(0.5, 0.5)
                        textLabel.Parent = ScreenGui
                        screenEspCache[player] = textLabel
                    end

                    local headPos, onScreen = Camera:WorldToViewportPoint(char.Head.Position + Vector3.new(0, 1.2, 0))
                    if onScreen then
                        local dist = localHRP and math.floor((char.HumanoidRootPart.Position - localHRP.Position).Magnitude) or 0
                        textLabel.Text = player.Name .. " [" .. tostring(dist) .. "m]"
                        textLabel.Position = UDim2.new(0, headPos.X, 0, headPos.Y)
                        textLabel.Visible = true
                    else
                        textLabel.Visible = false
                    end
                else
                    if textLabel then
                        textLabel.Visible = false
                    end
                end
            else
                removeScreenESP(player)
            end
        end
    end

    -- Aimbot Terkunci Murni di Tengah Layar (Anti-Geser Sentuhan)
    if Config.Aimbot then
        local closestTarget = nil
        local shortestDist = Config.FOVSize

        for _, player in ipairs(Players:GetPlayers()) do
            if isRealEnemy(player) and player.Character then
                local char = player.Character
                local targetPart = Config.AimHead and char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                
                if targetPart then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and isVisible(targetPart, char) then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPoint.X, screenPoint.Y) - centerScreen).Magnitude
                            if screenDist < shortestDist then
                                shortestDist = screenDist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            -- Mengunci langsung menghadap target tanpa terpengaruh input sentuhan geser layar bebas
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestTarget.Position)
        end
    end
end)

