local function setupBillboardESP(player, char)
    if player == LocalPlayer then return end
    local head = char:WaitForChild("Head", 5)
    if not head then return end

    local hl = char:FindFirstChild("DW_Highlight")
    if not hl then
        hl = Instance.new("Highlight")
        hl.Name = "DW_Highlight"
        hl.Adornee = char
        hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        hl.Parent = char
    end

    local bg = char:FindFirstChild("DW_MobileESP")
    if not bg then
        bg = Instance.new("BillboardGui")
        bg.Name = "DW_MobileESP"
        bg.Size = UDim2.new(0, 200, 0, 50)
        bg.StudsOffset = Vector3.new(0, 3, 0)
        bg.AlwaysOnBack = true
        bg.Adornee = head
        
        local txt = Instance.new("TextLabel")
        txt.Name = "Label"
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.TextScaled = true
        txt.Font = Enum.Font.SourceSansBold
        txt.TextStrokeTransparency = 0
        txt.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
        txt.Parent = bg
        
        bg.Parent = char
    end
end

local function onPlayerAdded(player)
    player.CharacterAdded:Connect(function(char)
        task.wait(0.5)
        setupBillboardESP(player, char)
    end)
    if player.Character then
        task.spawn(function()
            setupBillboardESP(player, player.Character)
        end)
    end
end

Players.PlayerAdded:Connect(onPlayerAdded)
