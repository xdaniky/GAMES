end

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    
    if Config.Aimbot and Config.FOV then
        FOVFrame.Visible = true
        FOVFrame.Position = UDim2.new(0, mousePos.X, 0, mousePos.Y)
        local size = Config.FOVSize * 2
        FOVFrame.Size = UDim2.new(0, size, 0, size)
    else
        FOVFrame.Visible = false
    end

    if Config.Crosshair then
        local vpSize = Camera.ViewportSize
        local cx, cy = vpSize.X / 2, vpSize.Y / 2
        local s = Config.CrosshairSize

        CrossH.Visible = true
        CrossH.Position = UDim2.new(0, cx, 0, cy)
        CrossH.Size = UDim2.new(0, s * 2, 0, 2)
        CrossH.BackgroundColor3 = Config.CrosshairColor

        CrossV.Visible = true
        CrossV.Position = UDim2.new(0, cx, 0, cy)
        CrossV.Size = UDim2.new(0, 2, 0, s * 2)
        CrossV.BackgroundColor3 = Config.CrosshairColor
    else
        CrossH.Visible = false
        CrossV.Visible = false
    end

    local localChar = LocalPlayer.Character
    local localHRP = localChar and localChar:FindFirstChild("HumanoidRootPart")

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char then
                local hl = char:FindFirstChild("DW_Highlight")
                local bg = char:FindFirstChild("DW_MobileESP")

                if hl then
                    if Config.Chams then
                        if isRealEnemy(player) then
                            hl.FillColor = Config.EnemyColor
                            hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                        else
                            hl.FillColor = Config.TeamColor
                            hl.OutlineColor = Color3.fromRGB(0, 0, 0)
                        end
                        hl.Enabled = true
                    else
                        hl.Enabled = false
                    end
                end

                if bg and bg:FindFirstChild("Label") then
                    if Config.BillboardESP and isRealEnemy(player) then
                        if localHRP and char:FindFirstChild("HumanoidRootPart") then
                            local dist = math.floor((char.HumanoidRootPart.Position - localHRP.Position).Magnitude)
                            bg.Label.Text = player.Name .. " [" .. dist .. "m]"
                        else
                            bg.Label.Text = player.Name
                        end
                        bg.Enabled = true
                    else
                        bg.Enabled = false
                    end
                end
            end
        end
    end

    if Config.Aimbot then
        local closestTarget = nil
        local shortestDist = Config.FOVSize

        for _, player in ipairs(Players:GetPlayers()) do
            if isRealEnemy(player) and player.Character then
                local char = player.Character
                local targetPart = Config.AimHead and char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                
                if targetPart then
                    local hum = char:FindFirstChildOfClass("Humanoid")
                    if hum and hum.Health > 0 and isVisible(targetPart, char) then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(screenPoint.X, screenPoint.Y) - mousePos).Magnitude
                            if screenDist < shortestDist then
                                shortestDist = screenDist
                                closestTarget = targetPart
                            end
                        end
                    end
                end
            end
        end

        if closestTarget then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, closestTarget.Position), 0.3)
        end
    end
end)

